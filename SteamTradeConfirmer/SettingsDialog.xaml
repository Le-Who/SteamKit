<Window x:Class="SteamTradeConfirmer.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="300" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки Steam Trade Confirmer" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Steam Web API Key:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="ApiKeyTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Получить API ключ можно на сайте:" FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="4" Text="https://steamcommunity.com/dev/apikey" FontSize="10" Foreground="Blue" 
                   MouseLeftButtonDown="ApiKeyLink_MouseLeftButtonDown" Cursor="Hand"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="CancelButton_Click" Margin="0,0,10,0" MinWidth="80"/>
            <Button Content="Сохранить" Click="SaveButton_Click" IsDefault="True" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
