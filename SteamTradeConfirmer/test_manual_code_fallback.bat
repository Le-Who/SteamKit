@echo off
chcp 65001 >nul
echo ========================================
echo ТЕСТИРОВАНИЕ FALLBACK НА РУЧНОЙ ВВОД КОДА
echo ========================================
echo.
echo Критическое исправление:
echo ✅ Добавлен fallback на ручной ввод после неправильного TOTP
echo ✅ Очистка кэша неправильного кода
echo ✅ Предотвращение бесконечного цикла неправильных кодов
echo ✅ Возможность ввести правильный код вручную
echo.

echo Сборка проекта...
dotnet build --configuration Release

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ✅ СБОРКА УСПЕШНА!
    echo.
    echo Ожидаемое поведение:
    echo 🔧 "✅ TOTP код сгенерирован и кэширован: XXXXXX" (первая попытка)
    echo 🔧 "⚠️ Предыдущий TOTP код был неправильным, запрашиваем ручной ввод" (после ошибки)
    echo 🔧 Появится диалог: "TOTP код был неправильным. Введите код вручную..."
    echo 🔧 Вы сможете ввести правильный код из мобильного приложения
    echo 🔧 Аутентификация пройдет успешно с правильным кодом
    echo.
    echo Ключевые улучшения:
    echo - НЕТ бесконечного цикла неправильных кодов
    echo - Возможность ввести правильный код вручную
    echo - Очистка кэша неправильного кода
    echo - Fallback на ручной ввод после первой ошибки
    echo.
    echo Теперь вы сможете ввести правильный код!
    echo.
    echo Готово к тестированию:
    echo .\launch.bat
) else (
    echo.
    echo ❌ ОШИБКА СБОРКИ!
    echo Проверьте сообщения об ошибках выше.
)

echo.
pause
