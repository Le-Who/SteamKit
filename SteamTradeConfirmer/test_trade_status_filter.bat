@echo off
chcp 65001 >nul
echo ========================================
echo ТЕСТИРОВАНИЕ ФИЛЬТРАЦИИ ПО СТАТУСУ ТРЕЙДОВ
echo ========================================
echo.
echo Исправления:
echo ✅ Исправлена ошибка TOTP Base32 с подробным логированием
echo ✅ Добавлена фильтрация трейдов по статусу CreatedNeedsConfirmation (9)
echo ✅ Подробное логирование статусов всех трейдов
echo ✅ Показ только трейдов, требующих мобильного подтверждения
echo.

echo Сборка проекта...
dotnet build --configuration Release

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ✅ СБОРКА УСПЕШНА!
    echo.
    echo Ожидаемые изменения в логах:
    echo 🔧 "🔍 SharedSecret найден: XXXXXX..." (без ошибок Base32)
    echo 🔧 "🔍 Отправленный трейд XXXXXX: статус X" (статусы всех трейдов)
    echo 🔧 "🔍 Полученный трейд XXXXXX: статус X" (статусы всех трейдов)
    echo 🔧 "✅ Добавлен трейд XXXXXX (требует подтверждения)" (только статус 9)
    echo 🔧 "⚠️ Нет трейдов со статусом 'CreatedNeedsConfirmation' (9)"
    echo.
    echo Теперь приложение:
    echo - Показывает статусы ВСЕХ трейдов для диагностики
    echo - Фильтрует только трейды со статусом 9 (требуют подтверждения)
    echo - Обрабатывает ошибки TOTP с подробным логированием
    echo.
    echo Готово к тестированию:
    echo .\launch.bat
) else (
    echo.
    echo ❌ ОШИБКА СБОРКИ!
    echo Проверьте сообщения об ошибках выше.
)

echo.
pause
