@echo off
chcp 65001 >nul
echo ========================================
echo ИСПРАВЛЕНИЕ КОДИРОВКИ КОНСОЛИ
echo ========================================
echo.
echo Этот скрипт исправит проблемы с кодировкой
echo в Windows консоли для корректного отображения
echo русского текста и эмодзи.
echo.

echo 1. Установка кодировки UTF-8...
chcp 65001
echo Кодировка установлена: UTF-8
echo.

echo 2. Проверка отображения символов...
echo Русский текст: Привет, мир!
echo Эмодзи: ✅ ❌ ⚠️ 🔍 🔧 🚨 🎉
echo.

echo 3. Настройка шрифта консоли...
echo Рекомендуется использовать шрифт "Consolas" или "Lucida Console"
echo для лучшего отображения символов.
echo.

echo 4. Проверка завершена!
echo Теперь все batch файлы должны корректно отображать
echo русский текст и эмодзи.
echo.

echo Нажмите любую клавишу для продолжения...
pause >nul

echo.
echo Запуск основного приложения...
cd /d "%~dp0bin\Release\net8.0-windows"
SteamTradeConfirmer.exe
