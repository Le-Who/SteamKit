@echo off
chcp 65001 >nul
echo ========================================
echo ТЕСТИРОВАНИЕ ИСПРАВЛЕНИЯ ТРЕЙДОВ
echo ========================================
echo.
echo Исправления:
echo ✅ Исправлен парсинг fully_enrolled в .maFile (object вместо string)
echo ✅ Запрос ВСЕХ трейдов (отправленных И полученных)
echo ✅ Обработка обоих типов трейдов
