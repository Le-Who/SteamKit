    echo 🔧 "📥 Найдено X полученных трейдов"
    echo 🔧 "📋 Итого обработано X трейдов"
    echo.
    echo Теперь приложение ищет:
    echo - Отправленные трейды (которые вы отправили)
    echo - Полученные трейды (которые вам отправили)
    echo - Все трейды, ожидающие мобильного подтверждения
    echo.
    echo Готово к тестированию:
    echo .\launch.bat
) else (
    echo.
    echo ❌ ОШИБКА СБОРКИ!
    echo Проверьте сообщения об ошибках выше.
)

echo.
pause
